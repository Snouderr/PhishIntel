# Copy this file to .env (same folder) and fill in what you have.
# .env is git-ignored — never commit real keys or put them in frontend JS.
# Every key is optional: without one, that feature falls back gracefully.

# AI summaries (Google Gemini). Without it, summaries are generated from the findings.
GEMINI_API_KEY=
# Optional: pin a model, e.g. gemini-2.5-flash. Leave empty to auto-pick the newest
# stable "flash" model your key can use.
GEMINI_MODEL=

# Optional threat-intel lookups
VIRUSTOTAL_API_KEY=
URLHAUS_AUTH_KEY=

# Local LLM via Ollama (https://ollama.com) — nothing leaves your machine.
# Install Ollama, then: ollama pull llama3.1:8b
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
