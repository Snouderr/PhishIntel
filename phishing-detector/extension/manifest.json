{
  "manifest_version": 3,
  "name": "Phishing URL Detector",
  "version": "2.0.0",
  "description": "Flags likely phishing pages in real time using an ML model, and explains why.",
  "permissions": ["tabs", "storage", "webNavigation"],
  "host_permissions": ["http://localhost:8000/*", "http://127.0.0.1:8000/*"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Phishing Detector"
  },
  "options_page": "options.html",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
